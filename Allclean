#!/usr/bin/env bash
# Remove only outputs that this repository can regenerate.
set -euo pipefail

case_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$case_dir"

find . -maxdepth 1 -type d -regex './processor[0-9][0-9]*' -prune -exec rm -rf -- {} +
find . -maxdepth 1 -type d -regex './[0-9][0-9]*\(\.[0-9][0-9]*\)*' ! -name 0 -prune -exec rm -rf -- {} +
rm -rf -- constant/polyMesh postProcessing VTK Ensight dynamicCode
rm -f -- log.* core core.*
