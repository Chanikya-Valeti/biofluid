FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      C;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Normalised dissolved-species concentration (e.g. oxygen): C = 1 in the
// inflow, C = 0 on the wall (the surrounding tissue consumes everything that
// reaches it, the classical Graetz constant-wall-concentration problem).

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    INLET
    {
        type            fixedValue;
        value           uniform 1;
    }
    OUTLET
    {
        type            zeroGradient;
    }
    WALL
    {
        type            fixedValue;
        value           uniform 0;
    }
}

