FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         300;

deltaT          1;

writeControl    timeStep;

writeInterval   300;

purgeWrite      2;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

// Radial sampling line: 101 points from the axis to the wall
radialLine
{
    type    uniform;
    axis    x;
    nPoints 101;
}

functions
{
    // Steady advection-diffusion of C on the current velocity field,
    // solved every SIMPLE iteration. D: oxygen in plasma, 2e-9 m^2/s,
    // giving a Peclet number Pe = U D / D_C = 250.
    concentration
    {
        type            scalarTransport;
        libs            (solverFunctionObjects);
        field           C;
        D               2e-09;
        bounded01       false;
    }

    // Radial profiles of C and U at six stations along the vessel
    profiles
    {
        type            sets;
        libs            (sampling);
        writeControl    writeTime;
        interpolationScheme cellPoint;
        setFormat       raw;
        fields          (C U);
        sets
        {
            y01 { $radialLine; start (0 0.0001 0); end (0.00005 0.0001 0); }
            y02 { $radialLine; start (0 0.0002 0); end (0.00005 0.0002 0); }
            y04 { $radialLine; start (0 0.0004 0); end (0.00005 0.0004 0); }
            y07 { $radialLine; start (0 0.0007 0); end (0.00005 0.0007 0); }
            y10 { $radialLine; start (0 0.0010 0); end (0.00005 0.0010 0); }
            y15 { $radialLine; start (0 0.0015 0); end (0.00005 0.0015 0); }
        }
    }
}

