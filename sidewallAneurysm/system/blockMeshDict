FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Background mesh for snappyHexMesh: 0.25 mm cubic cells (16 across the
// parent artery) in a box around constant/triSurface/aneurysm.stl.

scale 1;

xmin -0.003125;  xmax 0.003125;
ymin -0.0322;    ymax 0.0482;
zmin -0.0021;    zmax 0.0074;

vertices
(
    ($xmin $ymin $zmin)
    ($xmax $ymin $zmin)
    ($xmax $ymax $zmin)
    ($xmin $ymax $zmin)
    ($xmin $ymin $zmax)
    ($xmax $ymin $zmax)
    ($xmax $ymax $zmax)
    ($xmin $ymax $zmax)
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (25 322 38) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    background
    {
        type patch;
        faces
        (
            (0 3 2 1)
            (4 5 6 7)
            (0 4 7 3)
            (1 2 6 5)
            (0 1 5 4)
            (3 7 6 2)
        );
    }
);

