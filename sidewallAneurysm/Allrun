#!/usr/bin/env bash
# Run this case after sourcing the OpenFOAM v2412 environment.
# Usage: ./Allrun [serial|parallel]
#   parallel uses numberOfSubdomains from system/decomposeParDict
# The result is checked with validate.py (needs python3 + numpy).
set -euo pipefail

case_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$case_dir"

mode="${1:-serial}"
if [[ "$mode" != "serial" && "$mode" != "parallel" ]]; then
    echo "Usage: $0 [serial|parallel]" >&2
    exit 2
fi

for command in blockMesh surfaceFeatureExtract snappyHexMesh checkMesh simpleFoam; do
    command -v "$command" >/dev/null || {
        echo "Required OpenFOAM command not found: $command" >&2
        echo "Source your OpenFOAM environment before running this script." >&2
        exit 1
    }
done

# Background mesh, feature edges, then the body-fitted mesh (serial; ~1 min)
blockMesh | tee log.blockMesh
surfaceFeatureExtract | tee log.surfaceFeatureExtract
snappyHexMesh -overwrite | tee log.snappyHexMesh
checkMesh | tee log.checkMesh

if [[ "$mode" == "parallel" ]]; then
    for command in decomposePar reconstructPar mpirun foamDictionary; do
        command -v "$command" >/dev/null || {
            echo "Required parallel command not found: $command" >&2
            exit 1
        }
    done

    n_subdomains="$(foamDictionary system/decomposeParDict -entry numberOfSubdomains -value | tr -d '[:space:];')"
    [[ "$n_subdomains" =~ ^[1-9][0-9]*$ ]] || {
        echo "Could not read numberOfSubdomains from system/decomposeParDict" >&2
        exit 1
    }

    decomposePar -force | tee log.decomposePar
    mpirun -np "$n_subdomains" simpleFoam -parallel | tee log.simpleFoam
    reconstructPar -latestTime | tee log.reconstructPar
else
    simpleFoam | tee log.simpleFoam
fi

if command -v python3 >/dev/null && python3 -c "import numpy" 2>/dev/null; then
    python3 validate.py | tee log.validate
else
    echo "python3 with numpy not found: skipping validate.py" >&2
fi
