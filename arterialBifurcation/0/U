FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Parent-vessel mean velocity 0.0825 m/s: Re = U Dp / nu = 150.
// The inlet profile is recycled from the plane 2 Dp downstream (mappedPatch
// INLET, set up in system/snappyHexMeshDict) and rescaled to the mean
// velocity, so a fully developed Poiseuille profile enters the domain.

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    INLET
    {
        type                mapped;
        field               U;
        setAverage          true;
        average             (0 0.0825 0);
        interpolationScheme cell;
        value               uniform (0 0.0825 0);
    }
    "OUTLET.*"
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (0 0 0);
    }
    WALL
    {
        type            noSlip;
    }
}

