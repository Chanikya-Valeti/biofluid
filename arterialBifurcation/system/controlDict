FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         1500;

deltaT          1;

writeControl    timeStep;

writeInterval   500;

purgeWrite      2;

writeFormat     binary;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
    inletFlow
    {
        type            surfaceFieldValue;
        libs            (fieldFunctionObjects);
        writeControl    timeStep;
        writeInterval   10;
        log             false;
        writeFields     false;
        regionType      patch;
        name            INLET;
        operation       sum;
        fields          (phi);
    }

    outlet1Flow
    {
        $inletFlow;
        name            OUTLET1;
    }

    outlet2Flow
    {
        $inletFlow;
        name            OUTLET2;
    }

    wallShearStress
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        patches         (WALL);
        writeControl    writeTime;
        log             false;
    }

    // Wall shear stress on every wall face (for validate.py)
    wallData
    {
        type            surfaces;
        libs            (sampling);
        writeControl    writeTime;
        surfaceFormat   raw;
        fields          (wallShearStress p);
        interpolationScheme cell;
        surfaces
        {
            wall
            {
                type        patch;
                patches     (WALL);
                interpolate false;
            }
        }
    }

    // Parent-vessel centreline (for the upstream pressure gradient)
    lines
    {
        type            sets;
        libs            (sampling);
        writeControl    writeTime;
        interpolationScheme cellPoint;
        setFormat       raw;
        fields          (U p);
        sets
        {
            parentAxis
            {
                type    uniform;
                axis    y;
                start   (0 -0.0355 0);
                end     (0  0      0);
                nPoints 356;
            }
        }
    }
}

