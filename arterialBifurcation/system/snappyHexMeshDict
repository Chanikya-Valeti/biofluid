FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    bifurcation.stl
    {
        type    triSurfaceMesh;
        name    vessel;
        regions
        {
            INLET   { name INLET; }
            OUTLET1 { name OUTLET1; }
            OUTLET2 { name OUTLET2; }
            WALL    { name WALL; }
        }
    }
}

castellatedMeshControls
{
    maxLocalCells       2000000;
    maxGlobalCells      10000000;
    minRefinementCells  0;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 3;

    features
    (
        {
            file    "bifurcation.eMesh";
            level   0;
        }
    );

    refinementSurfaces
    {
        vessel
        {
            level   (0 0);
            regions
            {
                INLET
                {
                    level   (0 0);
                    patchInfo
                    {
                        // Recycle the velocity profile from 2 Dp downstream
                        type        mappedPatch;
                        sampleMode  nearestCell;
                        sampleRegion region0;
                        samplePatch none;
                        offset      (0 0.012 0);
                    }
                }
                OUTLET1 { level (0 0); patchInfo { type patch; } }
                OUTLET2 { level (0 0); patchInfo { type patch; } }
                WALL    { level (0 0); patchInfo { type wall; } }
            }
        }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
    }

    // A point inside the parent vessel
    locationInMesh (0.0001 -0.02 0.0001);

    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch        3;
    tolerance           2.0;
    nSolveIter          100;
    nRelaxIter          5;
    nFeatureSnapIter    10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;
}

addLayersControls
{
    relativeSizes       true;

    layers
    {
        WALL
        {
            nSurfaceLayers 3;
        }
    }

    expansionRatio      1.2;
    finalLayerThickness 0.4;
    minThickness        0.1;
    nGrow               0;
    featureAngle        130;
    slipFeatureAngle    30;
    nRelaxIter          5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals      3;
    nSmoothThickness    10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle  90;
    nBufferCellsNoExtrude 0;
    nLayerIter          50;
}

meshQualityControls
{
    maxNonOrtho         65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave          80;
    minVol              1e-18;
    minTetQuality       1e-15;
    minArea             -1;
    minTwist            0.02;
    minDeterminant      0.001;
    minFaceWeight       0.05;
    minVolRatio         0.01;
    minTriangleTwist    -1;
    nSmoothScale        4;
    errorReduction      0.75;

    relaxed
    {
        maxNonOrtho     75;
    }
}

mergeTolerance 1e-6;

// ************************************************************************* //
