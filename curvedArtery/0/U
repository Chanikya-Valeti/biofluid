FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Mean velocity 0.2475 m/s: Re = U D / nu = 300 and Dean number
// De = Re sqrt(R/Rc) = 113. The inlet profile is recycled from 2 D
// downstream in the straight inlet leg (fully developed Poiseuille inflow).

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    INLET
    {
        type                mapped;
        field               U;
        setAverage          true;
        average             (0 0.2475 0);
        interpolationScheme cell;
        value               uniform (0 0.2475 0);
    }
    OUTLET
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (0 0 0);
    }
    WALL
    {
        type            noSlip;
    }
}

