FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Carreau blood model (Cho & Kensey 1991), used by ./Allrun carreau.
// See carreauBloodPipe for the verification of this model.

transportModel  BirdCarreau;

BirdCarreauCoeffs
{
    nu0         [0 2 -1 0 0 0 0] 5.2830e-05;
    nuInf       [0 2 -1 0 0 0 0] 3.2547e-06;
    k           [0 0 1 0 0 0 0]  3.313;
    n           [0 0 0 0 0 0 0]  0.3568;
    a           [0 0 0 0 0 0 0]  2;
}

// ************************************************************************* //
