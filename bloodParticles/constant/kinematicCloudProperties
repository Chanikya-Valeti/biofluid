FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      kinematicCloudProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// One-way coupled particles in blood (the particles do not affect the flow).
// All particles have density 2000 kg/m^3; two injectors release
//   tracers : d = 1 um   at r/R = 0, 0.2, 0.4, 0.6, 0.8 (they follow the flow)
//   debris  : d = 200 um at three heights (they settle across the vessel
//             under gravity and deposit on the lower wall)
// Drag follows the Schiller-Naumann sphere drag law; gravity includes buoyancy.

solution
{
    active          true;
    coupled         false;
    transient       yes;
    cellValueSourceCorrection off;
    maxCo           0.3;

    sourceTerms
    {
        schemes
        {
        }
    }

    interpolationSchemes
    {
        rho             cell;
        U               cellPoint;
        mu              cell;
    }

    integrationSchemes
    {
        U               analytical;
    }
}

constantProperties
{
    rho0            2000;
}

subModels
{
    particleForces
    {
        sphereDrag;
        gravity;
    }

    injectionModels
    {
        tracers
        {
            type            manualInjection;
            massTotal       0;
            parcelBasisType fixed;
            nParticle       1;
            SOI             0;
            positionsFile   "tracerPositions";
            U0              (0 0 0);
            sizeDistribution
            {
                type        fixedValue;
                fixedValueDistribution
                {
                    value   1e-06;
                }
            }
        }

        debris
        {
            type            manualInjection;
            massTotal       0;
            parcelBasisType fixed;
            nParticle       1;
            SOI             0;
            positionsFile   "debrisPositions";
            U0              (0 0 0);
            sizeDistribution
            {
                type        fixedValue;
                fixedValueDistribution
                {
                    value   2e-04;
                }
            }
        }
    }

    dispersionModel none;

    patchInteractionModel localInteraction;

    localInteractionCoeffs
    {
        patches
        (
            WALL
            {
                type    stick;
            }
            "(INLET|OUTLET)"
            {
                type    escape;
            }
        );
    }

    surfaceFilmModel none;

    stochasticCollisionModel none;

    collisionModel none;
}

cloudFunctions
{
    // Records every particle reaching the wall or the outlet: time, position,
    // diameter and velocity (used by validate.py)
    wallAndOutlet
    {
        type            particlePostProcessing;
        maxStoredParcels 100;
        patches         (WALL OUTLET);
    }
}

