FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setExprFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Fully developed Poiseuille flow in the R = 2 mm vessel with mean velocity
// Um = 0.05 m/s (centreline 0.1 m/s, Re = 2 R Um / nu = 61):
//     u_y = 2 Um (1 - (x^2 + z^2) / R^2)

expressions
(
    U
    {
        field       U;
        dimensions  [0 1 -1 0 0 0 0];
        expression
        #{
            vector(0, 0.1*max(0, 1 - (sqr(pos().x()) + sqr(pos().z()))/4e-6), 0)
        #};
    }
);

